# Rendered by the nginx image's envsubst step at container start:
#   PORT                  listen port (80 by default; App Service expects WEBSITES_PORT to match)
#   API_UPSTREAM          scheme://host[:port] of the API, no trailing slash
#                         compose: http://api:8080   App Service: https://<api-app>.azurewebsites.net
#   NGINX_LOCAL_RESOLVERS filled from /etc/resolv.conf by the image (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1)

# Resolve the upstream at request time, not once at start-up: App Service IPs
# change, and the API may come up after this container.
resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    set $api_upstream ${API_UPSTREAM};

    # Same-origin API, as in vite.config.ts and vercel.json.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        # Send the API's own host name, not the browser's: App Service routes by
        # Host, and TLS needs the matching SNI.
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # AI surfaces can wait on an LLM (NTT_LLM_TIMEOUT, 35s default) and the
        # first request trains the closure model.
        proxy_read_timeout 120s;
    }

    location = /healthz {
        proxy_pass $api_upstream;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
    }

    # Hashed build assets never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA fallback; index.html must not be cached so new builds are picked up.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
